# .env.example — Takshashila RAG. Copy to .env and fill in real values.
# Audit finding: no .env.example existed in this repo at all. Every variable
# below was confirmed by grepping every os.getenv()/os.environ.get() call in
# src/, integrations/, and scripts/ — nothing here is invented, and nothing
# in this file is a real secret.
#
# .env is already excluded from both git (.gitignore) and Docker build
# contexts (.dockerignore) — never commit it or bake it into an image.

# ── LLM (required for answer generation) ────────────────────────────────────
# There is exactly ONE supported model. GROQ_MODEL must be this value; any other
# value raises a clear operational error rather than silently switching models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Retrieval / grounding thresholds ─────────────────────────────────────────
TOP_K=5
MIN_SCORE_THRESHOLD=0.35
CONF_HIGH_THRESHOLD=0.62
CONF_MEDIUM_THRESHOLD=0.48
GROUNDING_MIN_OVERLAP=0.18
VERIFY_CITATIONS=true
# Lexical (exact-match) evidence: a chunk that fully covers a short query's
# salient tokens ("ATP", "All Things Policy") counts as evidence even when its
# dense cosine score is low. This is a precision-preserving supplement to the
# dense gate, NOT a lowering of MIN_SCORE_THRESHOLD.
LEXICAL_MIN_SCORE=0.55
# Fractional boost applied per source-priority tier (see src/config.py). Leave
# blank to use the built-in default (0.12) — a blank numeric setting anywhere
# in this file safely falls back to its default rather than crashing startup.
SOURCE_PRIORITY_BOOST=

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
CHUNK_MIN_LEN=200

# ── Website crawl ────────────────────────────────────────────────────────────
WEBSITE_BASE_URL=https://takshashila.org.in/
# See src/config.py's audit note — left empty by default; a live check found
# real content on legion.takshashila.org.in / school.takshashila.org.in but
# whether to include them is a call for whoever owns the site.
WEBSITE_ADDITIONAL_DOMAINS=
WEBSITE_MAX_DEPTH=8
WEBSITE_MAX_PAGES=5000
WEBSITE_MIN_TEXT_LEN=200
WEBSITE_INCLUDE_PDFS=true

# ── Crawl politeness / retries ───────────────────────────────────────────────
SCRAPE_DELAY=1.0
SCRAPE_TIMEOUT=20
SCRAPE_MAX_RETRIES=3
SCRAPE_MAX_WORKERS=4

# ── Commit KB (authenticated internal source — optional; the pipeline
#    degrades gracefully with a "skipped: no credentials" status if unset) ──
COMMIT_KB_URL=
COMMIT_KB_USERNAME=
COMMIT_KB_PASSWORD=

# ── Weekly auto-refresh schedule ─────────────────────────────────────────────
# Default: every Monday at 18:00 IST.
SCHEDULE_DAY=mon
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Kolkata

# ── Streamlit dashboard admin gate (see app.py's audit note) ────────────────
# Leave empty for a trusted single-operator deployment (a visible warning is
# shown instead of silently pretending to be secure). Set a long random value
# before exposing the dashboard beyond a trusted network — it gates the
# Build & Update / Automation tabs' destructive actions.
DASHBOARD_ADMIN_PASSWORD=

# ── Mattermost bot — core ────────────────────────────────────────────────────
MATTERMOST_URL=https://your-mattermost-server.example.com
# The token Mattermost gives you when you create the /askkb slash command.
MATTERMOST_SLASH_TOKEN=
# A personal access token or bot account token — required for DMs, posting to
# other channels/groups, deleting posts, and PDF/Markdown export uploads.
MATTERMOST_BOT_TOKEN=
# Publicly reachable base URL of THIS bot service (e.g. behind a reverse
# proxy/tunnel you control — never ngrok.exe in production; see README).
#
# *** REQUIRED for every interactive button under an answer: ***
# Export Markdown, Download PDF, Share to User/Channel/Group, Helpful /
# Not Helpful, Delete this response, Delete all — and for voice input. With
# this left blank, ENABLE_BUTTONS is force-disabled and NONE of those buttons
# appear, regardless of any other setting below. This is a Mattermost
# requirement, not a bug: Mattermost's server calls back to this exact URL
# when a button is clicked, so it must be a real address Mattermost itself
# can reach (not localhost, unless Mattermost is also running locally on the
# same host/network).
MATTERMOST_BOT_PUBLIC_URL=

# ── Backend RAG API (the /api/query endpoint the static dashboard calls) ──────
# Comma-separated exact origins allowed to call /api/query from a browser (the
# GitHub Pages site + any custom domain). Never use "*" here. Leave blank to
# disable CORS entirely (same-origin / server-to-server callers only).
API_ALLOWED_ORIGINS=
# Optional shared secret for /api/query. If set, callers must send it as the
# "X-API-Key" header. Leave blank for an unauthenticated read-only query API.
API_KEY=

# ── Mattermost bot — network ─────────────────────────────────────────────────
MATTERMOST_BOT_HOST=0.0.0.0
MATTERMOST_BOT_PORT=8000
MATTERMOST_HTTP_TIMEOUT=25

# ── Mattermost bot — access control ──────────────────────────────────────────
# Comma-separated allowlists. Leave empty to allow any team/channel that has
# the slash command installed.
MATTERMOST_ALLOWED_TEAM_IDS=
MATTERMOST_ALLOWED_CHANNEL_IDS=

# ── Mattermost bot — behaviour ────────────────────────────────────────────────
MATTERMOST_ANSWER_VISIBILITY=private
# How a PRIVATE answer reaches the asker:
#   "dm" (default, and the only mode with working buttons): a direct message
#       from the bot — full Export/Share/Feedback/Delete buttons all work.
#   "ephemeral": shown only to the requester inside the channel. Mattermost
#       ephemeral posts CANNOT carry interactive buttons or file downloads —
#       Export, Share, Feedback and Delete are all unavailable in this mode,
#       by a Mattermost platform limitation, not something this bot can work
#       around. Use "dm" if you want those buttons.
MATTERMOST_PRIVATE_DELIVERY=dm
MATTERMOST_PRIVATE_REPLIES=true
MATTERMOST_ENABLE_ROUTING=true
MATTERMOST_ENABLE_GROUP=true
MATTERMOST_ENABLE_SHARE_BUTTONS=true
# Master switch for every interactive button (Export/Share/Feedback/Delete).
# Still requires MATTERMOST_BOT_PUBLIC_URL to be set above — this only turns
# them off deliberately; it can't turn them on without a public URL.
MATTERMOST_ENABLE_BUTTONS=true
MATTERMOST_ENABLE_FEEDBACK=true
MATTERMOST_ENABLE_PROGRESS=true
MATTERMOST_PROGRESS_INTERVAL=2.0
MATTERMOST_ENABLE_PDF_EXPORT=true
MATTERMOST_WARM_RAG_ON_STARTUP=true
MATTERMOST_MAX_MESSAGE_CHARS=4000
MATTERMOST_RAG_TOP_K=5
MATTERMOST_SEARCH_TOP_K=5
MATTERMOST_RAG_TEMPERATURE=0.2

# ── Mattermost bot — voice input ─────────────────────────────────────────────
MATTERMOST_ENABLE_VOICE=true
MATTERMOST_VOICE_TTL_SECONDS=1800
# Signs voice-link tokens (see integrations/mattermost_bot.py's audit note).
# Falls back to MATTERMOST_SLASH_TOKEN, then a random per-process secret, if
# unset — set this explicitly for a stable secret across restarts.
MATTERMOST_VOICE_SECRET=
